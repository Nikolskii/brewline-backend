# Переменные окружения backend. Скопировать в .env и поправить под себя.
# .env в репозиторий не коммитится.

# Порт HTTP-сервера.
PORT=3000

# Строка подключения к MongoDB (включая имя базы).
# В docker-compose хост базы — имя сервиса 'mongo', а не localhost.
MONGO_URL=mongodb://localhost:27017/brewline

# Сколько минут заказ со статусом ready держится на табло, потом снимается сам.
READY_TTL_MINUTES=5

# Origin'ы фронтов, которым браузер разрешит читать ответы API (ADR 0004).
# Список через запятую, только явные адреса: '*' несовместим с credentials.
# По умолчанию — дев-адреса табло (5173) и интерфейса бариста (5174),
# доступные через localhost и 127.0.0.1. Это разные origin для браузера.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
